# Bu dosyayı ".env" adıyla kopyalayıp değerleri düzenleyin.
APP_ENV=development
DATABASE_URL=sqlite:///./kahvecell.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# JWT — üretimde mutlaka uzun ve rastgele bir değer kullanın
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# SMS OTP simülasyonu
OTP_SIMULATED_CODE=1234
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Rate limiting
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
